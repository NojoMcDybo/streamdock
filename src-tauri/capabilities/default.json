{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Nur das Hauptfenster (lokale Oberfläche): Fenstersteuerung und die App-Befehle.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-hide",
    "core:window:allow-toggle-maximize",
    "allow-start-stream",
    "allow-open-console",
    "allow-update-state",
    "allow-update-check",
    "allow-update-install",
    "allow-twitch-state",
    "allow-set-client-id",
    "allow-auth-start",
    "allow-auth-cancel",
    "allow-logout",
    "allow-live-streams"
  ]
}
